PROJECT_NAME           = "Doxygen Documentation Demo"
PROJECT_BRIEF          = "C++ API contracts linked to design documentation"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = include docs
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.dox *.md
EXCLUDE                = build

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

FORMULA_MACROFILE      = docs/formulas.tex
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3

MERMAIDFILE_DIRS       = docs/diagrams
MERMAID_RENDER_MODE    = CLIENT_SIDE

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
